{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "required": ["title", "status"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "assignee": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    }
  }
}
